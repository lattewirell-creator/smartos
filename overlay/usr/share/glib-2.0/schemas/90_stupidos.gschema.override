# Stupid OS desktop defaults. Users can change all of these in Settings.

[org.gnome.desktop.interface]
gtk-theme='Yaru'
icon-theme='Yaru'
cursor-theme='Yaru'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='DejaVu Sans Mono 11'
color-scheme='prefer-dark'
clock-show-weekday=true
show-battery-percentage=true
font-antialiasing='rgba'
font-hinting='slight'

[org.gnome.desktop.wm.preferences]
titlebar-font='Inter Semi-Bold 11'
button-layout='appmenu:minimize,maximize,close'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/stupidos/wallpaper-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/stupidos/wallpaper-dark.svg'
picture-options='zoom'
primary-color='#FAF9F5'
secondary-color='#EFEBE1'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/stupidos/wallpaper-dark.svg'
picture-options='zoom'
primary-color='#1F1E1D'

[org.gnome.desktop.sound]
theme-name='Yaru'

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
natural-scroll=true

[org.gnome.desktop.wm.keybindings]
# Super+Space belongs to Buddy, keyboard layouts move one key over
switch-input-source=['<Super><Alt>space', 'XF86Keyboard']
switch-input-source-backward=['<Shift><Super><Alt>space', '<Shift>XF86Keyboard']

[org.gnome.mutter]
center-new-windows=true
dynamic-workspaces=true
# Crisp fractional scaling on high-DPI screens, and the option to run 120 Hz+ screens with variable refresh rate
experimental-features=['scale-monitor-framebuffer', 'variable-refresh-rate']

[org.gnome.shell]
favorite-apps=['stupidos-install.desktop', '@BROWSER@', 'stupid-mail.desktop', 'stupid-buddy.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-writer.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']
enabled-extensions=['dash2dock-lite@icedman.github.com', 'ubuntu-appindicators@ubuntu.com', 'forge@jmmaranan.com', 'blur-my-shell@aunetx', 'rounded-window-corners@fxgn', 'openbar@neuromorph']

# The dock, macOS style: icons magnify under the pointer, apps bounce as they open, windows
# minimise with a magic-lamp effect, one dot under running apps, Trash at the far end.
# Dark frosted glass with a terracotta edge to match the island bar; it floats just off the edge
# and slides away when a window needs the space.
[org.gnome.shell.extensions.dash2dock-lite]
dock-location=0
icon-size=0.17
edge-distance=1.0
dock-padding=0.4
icon-spacing=0.4
shrink-icons=true
animate-icons=true
animation-magnify=0.5
animation-spread=0.6
animation-rise=0.3
open-app-animation=true
lamp-app-animation=true
autohide-dash=true
autohide-dodge=true
apps-icon=true
apps-icon-front=false
trash-icon=true
icon-shadow=true
blur-background=true
background-color=(0.122, 0.118, 0.114, 0.6)
border-radius=5.0
border-thickness=1
border-color=(0.851, 0.467, 0.341, 0.55)
separator-thickness=1
separator-color=(0.925, 0.914, 0.882, 0.2)
running-indicator-style=2
running-indicator-color=(0.851, 0.467, 0.341, 1.0)
notification-badge-color=(0.851, 0.467, 0.341, 1.0)

[org.gnome.nautilus.preferences]
default-folder-viewer='icon-view'

[org.gnome.TextEditor]
style-scheme='Adwaita'

[org.gnome.software]
packaging-format-preference=['flatpak', 'deb']

# ---------------------------------------------------------------------------
# The Stupid OS look: tiling with gaps, glass, rounded corners and a floating
# island bar (in the spirit of Hyprland), all in the house colours.
# ---------------------------------------------------------------------------

[org.gnome.shell.extensions.forge]
tiling-mode-enabled=true
quick-settings-enabled=true
window-gap-size=uint32 10
window-gap-hidden-on-single=false
focus-border-toggle=true
focus-border-size=uint32 2
focus-border-color='rgba(217, 119, 87, 1)'
split-border-color='rgba(236, 233, 225, 0.6)'
preview-hint-enabled=true
move-pointer-focus-enabled=false

# Hyprland-style: Super+arrows move focus, Shift moves the window, Ctrl swaps it.
# (Forge's vim keys would steal Super+L, the lock screen, and Super+H/V from GNOME.)
[org.gnome.shell.extensions.forge.keybindings]
window-focus-left=['<Super>Left']
window-focus-right=['<Super>Right']
window-focus-up=['<Super>Up']
window-focus-down=['<Super>Down']
window-move-left=['<Shift><Super>Left']
window-move-right=['<Shift><Super>Right']
window-move-up=['<Shift><Super>Up']
window-move-down=['<Shift><Super>Down']
window-swap-left=['<Ctrl><Super>Left']
window-swap-right=['<Ctrl><Super>Right']
window-swap-up=['<Ctrl><Super>Up']
window-swap-down=['<Ctrl><Super>Down']
con-split-horizontal=['<Super>z']
con-split-vertical=['<Shift><Super>z']

[org.gnome.mutter.keybindings]
toggle-tiled-left=[]
toggle-tiled-right=[]

[org.gnome.desktop.wm.keybindings]
maximize=[]
unmaximize=[]
move-to-monitor-left=[]
move-to-monitor-right=[]
move-to-monitor-up=[]
move-to-monitor-down=[]
close=['<Super>q', '<Alt>F4']
toggle-fullscreen=['<Super>f']

# The island bar owns the top panel and the dock blurs itself; Blur my Shell does the overview and app grid
[org.gnome.shell.extensions.blur-my-shell.panel]
blur=false

# Buddy's ball is a transparent round window: no rounded-corner frame or shadow around it
[org.gnome.shell.extensions.rounded-window-corners-reborn]
blacklist=['stupid-buddy', 'Stupid-buddy']

[org.gnome.shell.extensions.openbar]
bartype='Islands'
position='Top'
height=34.0
margin=6.0
bradius=14.0
bwidth=1
neon=true
shadow=true
font='Inter Semi-Bold 10.5'
bgcolor=['0.122', '0.118', '0.114']
dark-bgcolor=['0.122', '0.118', '0.114']
bgalpha=0.0
isalpha=0.78
fgcolor=['0.925', '0.914', '0.882']
dark-fgcolor=['0.925', '0.914', '0.882']
bcolor=['0.851', '0.467', '0.341']
dark-bcolor=['0.851', '0.467', '0.341']
balpha=0.55
hcolor=['0.851', '0.467', '0.341']
dark-hcolor=['0.851', '0.467', '0.341']
halpha=0.6
accent-override=true
accent-color=['0.851', '0.467', '0.341']
dark-accent-color=['0.851', '0.467', '0.341']
light-accent-color=['0.851', '0.467', '0.341']
mbgcolor=['0.122', '0.118', '0.114']
dark-mbgcolor=['0.122', '0.118', '0.114']
mbgalpha=0.92
apply-menu-shell=true
apply-accent-shell=true
color-scheme='prefer-dark'
# Accent for selections and sliders (Open Bar's default is cyan)
mscolor=['0.851', '0.467', '0.341']
dark-mscolor=['0.851', '0.467', '0.341']
light-mscolor=['0.851', '0.467', '0.341']
