[Unit]
Description=Add the Flathub app store to SmartOS
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/repo/flathub.trustedkeys.gpg

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
